{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.beriki770-ship-it/clickandsay",
  "description": "Website feedback cards in your coding agent: element selector, click point, DOM, console errors.",
  "repository": {
    "url": "https://github.com/beriki770-ship-it/clickandsay-mcp",
    "source": "github"
  },
  "websiteUrl": "https://clickandsay.com/",
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "clickandsay-mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CLICKANDSAY_API_KEY",
          "description": "Personal pk_live_ key from ClickAndSay admin -> Connect your AI",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "CLICKANDSAY_BASE",
          "description": "API base URL (default https://clickandsay.com)",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ]
}
